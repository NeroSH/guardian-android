<?xml version="1.0" encoding="utf-8"?><!--
  DEV ONLY: permits cleartext to the local Spring Boot backend on the emulator loopback.
  Production must use HTTPS and this whole file should be removed / replaced with a pinned config.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!--Emulator-->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!--IP of local backend-->
        <domain includeSubdomains="false">192.168.1.7</domain>
    </domain-config>
</network-security-config>
